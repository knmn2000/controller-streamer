<!-- Config for PadAccessibilityService.

     canRequestFilterKeyEvents + flagRequestFilterKeyEvents -> onKeyEvent for
     gamepad buttons.

     Motion event sources (analog sticks and triggers, API 34+) are NOT set
     here: android:motionEventSources is not exposed as an XML attribute in the
     android-35 platform, so the service calls setMotionEventSources() at
     runtime instead, guarded by an SDK_INT check.

     No accessibilityEventTypes are requested: this service reads gamepad input
     and nothing about screen content. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/accessibility_description"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRequestFilterKeyEvents"
    android:canRequestFilterKeyEvents="true"
    android:notificationTimeout="100" />
